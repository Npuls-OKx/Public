{
  "name": "okx-public",
  "private": true,
  "description": "Gereedschap voor de diagrammen in dit repository. De documenten zelf zijn markdown; node is alleen nodig om de LikeC4-modellen te renderen.",
  "devDependencies": {
    "likec4": "^1.59.4"
  },
  "scripts": {
    "diagrammen:controle": "likec4 validate Koppelvlakspecificaties/src/likec4-model",
    "diagrammen:preview": "likec4 start Koppelvlakspecificaties/src/likec4-model",
    "diagrammen:render": "bash scripts/likec4-render.sh Koppelvlakspecificaties/src/likec4-model Koppelvlakspecificaties/src/diagrammen"
  }
}
