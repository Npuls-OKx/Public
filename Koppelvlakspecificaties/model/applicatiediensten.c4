    }
  }
  spec.koppelingen.k_resultaatstructuur_ophalen -> instelling.sis 'afnemer' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }

  // Specificatie aanpassen op verzoek
  spec.koppelingen.k_specificatie_aanpassen_op_verzoek -> instelling.oc.ad_onderwijsspecificatie_uitwerking 'afgeleid van' {
