// De applicatiediensten uit de domeinarchitectuur, zoals de informatiestromen-
// hoofdplaat v1.7 en de view op de functionaliteit van het studentkeuzesysteem
// ze tonen. Per koppeling staat vast van welke dienst zij is afgeleid en tussen
// welke componenten zij ligt; die relaties dragen de tag #hoofdplaat en komen
// alleen op de hoofdplaatviews voor.
//
// Bron: het ArchiMate-model in Npuls-OKx/meta, en Koppelingen/ voor de afleiding.

specification {
  element applicatiedienst {
    notation 'Applicatiedienst uit de domeinarchitectuur'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size md
      padding sm
      border solid
      icon ./icons/service.svg
      iconPosition right
      iconSize xs
    }
  }

  tag hoofdplaat
}

model {

  extend instelling {
    metadata {
      hoofdplaatrij '1'
      hoofdplaatkolom '1'
    }
  }

  extend instelling.co {
    metadata {
      hoofdplaatrij '1'
      hoofdplaatkolom '1'
    }
    ad_nominale_route_meerjaar = applicatiedienst 'Nominale route meerjaar uitwerking'
  }

  extend instelling.oc {
    metadata {
      hoofdplaatrij '1'
      hoofdplaatkolom '2'
    }
    ad_onderwijsspecificatie_uitwerking = applicatiedienst 'Onderwijsspecificatie uitwerking'
  }

  extend instelling.p {
    metadata {
      hoofdplaatrij '1'
      hoofdplaatkolom '3'
    }
    ad_capaciteitsplanning = applicatiedienst '(Meer)jaar capaciteitsplanning'
    ad_jaarplanning = applicatiedienst 'Jaarplanning'
    ad_nominale_route_schooljaar = applicatiedienst 'Nominale route schooljaar'
    ad_periode_planning = applicatiedienst 'Periode planning'
  }

  extend instelling.rooster {
    metadata {
      hoofdplaatrij '1'
      hoofdplaatkolom '4'
    }
  }

  extend instelling.lms {
    metadata {
      hoofdplaatrij '2'
      hoofdplaatkolom '1'
    }
  }

  extend instelling.sks {
    metadata {
      hoofdplaatrij '2'
      hoofdplaatkolom '2'
    }
    ad_keuze_opleidingseenheid = applicatiedienst 'Keuze op opleidingseenheid'
    ad_keuze_leergelegenheid = applicatiedienst 'Keuze op leergelegenheid'
    ad_keuze_lesgelegenheid = applicatiedienst 'Keuze op lesgelegenheid'
    ad_accorderen = applicatiedienst 'Accorderen van keuzes'
    ad_keuze_aanvraag_beheer = applicatiedienst 'Keuze aanvraag beheer'
    ad_verwerken_definitieve_keuzes = applicatiedienst 'Verwerken van definitieve keuzes'
  }

  extend instelling.sis {
    metadata {
      hoofdplaatrij '3'
      hoofdplaatkolom '1'
    }
    ad_inschrijving = applicatiedienst 'Inschrijving op opleidingsprogramma'
  }

  extern = organisatie 'Buiten de instelling' {
    metadata {
      hoofdplaatrij '1'
      hoofdplaatkolom '2'
    }
    eduhub = systeem 'EduHub' {
      metadata {
        hoofdplaatrij '1'
        hoofdplaatkolom '1'
      }
    }
    cambo = systeem 'Voorziening Centraal Aanmelden (CAMBO)' {
      metadata {
        hoofdplaatrij '2'
        hoofdplaatkolom '1'
      }
    }
  }

  // De legenda van de hoofdplaatviews. Geen onderdeel van de keten: een voorbeeld
  // van wat de kleur en de twee lijnen op de plaat betekenen.
  legenda = organisatie 'Legenda' {
    koppeling = koppeling 'Koppeling' {
      metadata {
        hoofdplaatrij '1'
        hoofdplaatkolom '1'
      }
      style {
        color markering
        size sm
      }
    }
    rol = systeem 'Aanbieder of afnemer' {
      metadata {
        hoofdplaatrij '2'
        hoofdplaatkolom '1'
      }
      style {
        size sm
      }
    }
    dienst = applicatiedienst 'Applicatiedienst waarvan de koppeling is afgeleid' {
      metadata {
        hoofdplaatrij '2'
        hoofdplaatkolom '2'
      }
      style {
        color markering
        size sm
      }
    }
  }
  legenda.koppeling -> legenda.rol {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  legenda.koppeling -> legenda.dienst {
    #hoofdplaat
    style {
      line dotted
      head onormal
    }
  }

  // Onderwijsspecificatie ophalen
  spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.oc.ad_onderwijsspecificatie_uitwerking 'afgeleid van' {
    #hoofdplaat
    style {
      line dotted
      head onormal
    }
  }
  spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.oc 'aanbieder' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.p 'afnemer' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.sis 'afnemer' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.lms 'afnemer' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.sks 'afnemer' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }

  // Specificatiestatus volgen
  spec.koppelingen.k_specificatiestatus_volgen -> instelling.oc.ad_onderwijsspecificatie_uitwerking 'afgeleid van' {
    #hoofdplaat
    style {
      line dotted
      head onormal
    }
  }
  spec.koppelingen.k_specificatiestatus_volgen -> instelling.oc 'aanbieder' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  spec.koppelingen.k_specificatiestatus_volgen -> instelling.p 'afnemer' {
    #hoofdplaat
    style {
      line solid
      head none
    }
  }
  spec.koppelingen.k_specificatiestatus_volgen -> instelling.lms 'afnemer' {
