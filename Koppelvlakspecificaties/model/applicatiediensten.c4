  }

  // Keuzeaanbod ontsluiten
  spec.koppelingen.k_keuzeaanbod_ontsluiten -> instelling.oc.ad_onderwijsspecificatie_uitwerking 'afgeleid van' {
    #hoofdplaat
    style {
      line dotted
      head onormal
    }
  }
  spec.koppelingen.k_keuzeaanbod_ontsluiten -> instelling.oc 'aanbieder' {
