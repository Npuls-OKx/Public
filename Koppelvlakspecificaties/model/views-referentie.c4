// De views: per component met een koppelvlak een eigen plaat.
//
// De koppelvlakplaten dragen geen relaties: ze tonen wat een component aanbiedt,
// niet wie het aanroept. Dat betekent dat graphviz er geen bruikbare plaatsing
// voor oplevert; scripts/likec4-layout.py rekent die daarom zelf uit.

views {

  view koppelvlak_oc {
    title 'Referentie / Koppelvlak van de onderwijscatalogus'
    description '
      De koppelvlakdiensten die de catalogus implementeert, met onder elke dienst de
      endpoints waarmee zij die levert.
    '
    order 2

    autoLayout TopBottom 40 40

    include instelling.oc, instelling.oc.**
    exclude * -> *
    exclude element.tag = #v1
    exclude element.kind = applicatiedienst
  }

  view koppelvlak_p {
    title 'Referentie / Koppelvlak van het planningssysteem'
    description '
      Gedeeld met het roostersysteem; het rooster zelf blijft daar. Het
      planningssysteem biedt zijn opleidingsaanbod aan en neemt de meldingen over
      specificaties aan.
    '
    order 3

    autoLayout TopBottom 40 40

    include instelling.p, instelling.p.**
    exclude * -> *
    exclude element.tag = #v1
    exclude element.kind = applicatiedienst
  }

  view koppelvlak_sis {
    title 'Referentie / Koppelvlak van het studentinformatiesysteem'
    description '
      Het studentinformatiesysteem neemt twee dingen aan uit de catalogus: de
      onderwijsspecificatiestructuur en de resultaatstructuur.
    '
    order 4

    autoLayout TopBottom 40 40

    include instelling.sis, instelling.sis.**
    exclude * -> *
    exclude element.tag = #v1
    exclude element.kind = applicatiedienst
  }

  view koppelvlak_lms {
    title 'Referentie / Koppelvlak van het leermanagementsysteem'
    description '
      De lichtste van de vier: de leeromgeving neemt de structuur aan en biedt de
      leermiddelkoppeling aan.
    '
    order 5

    autoLayout TopBottom 40 40

    include instelling.lms, instelling.lms.**
    exclude * -> *
    exclude element.tag = #v1
    exclude element.kind = applicatiedienst
  }

  // Een koppeling ligt tussen één aanbieder en zijn afnemers; het koppelvlak van een
  // component is de optelsom van de koppelingen die het raken (U2). Hier voor het
  // leermanagementsysteem: drie koppelingen als aanbieder, vier als afnemer. Met
  // de tag #hoofdplaat legt scripts/likec4-hoofdplaat.py de plaat neer, zoals bij
  // de hoofdplaatviews: het component onderaan, de koppelingen op een rij erboven.
  view koppelvlak_versus_koppeling {
    #hoofdplaat
    title 'Uitgangspunten / Koppelvlak versus koppeling'
    description '
      Het koppelvlak van het leermanagementsysteem is de optelsom van de zeven
      koppelingen die het raken; elke koppeling noemt de rol die het daarin heeft.
    '

    autoLayout TopBottom 60 40

    include instelling.lms with {
      description ''
      color markering
      size xl
    }
    include spec.koppelingen.k_onderwijsspecificatie_ophalen with {
      description 'Rol: afnemer'
      color markering
    }
    include spec.koppelingen.k_specificatiestatus_volgen with {
      description 'Rol: afnemer'
      color markering
    }
    include spec.koppelingen.k_opleidingsprogrammaverbintenis_ontsluiten with {
      description 'Rol: afnemer'
      color markering
    }
    include spec.koppelingen.k_verbintenis_en_planninggroep_doorgeven with {
      description 'Rol: afnemer'
      color markering
    }
    include spec.koppelingen.k_leeromgeving_inrichten with {
      description 'Rol: aanbieder'
      color markering
    }
    include spec.koppelingen.k_leeromgeving_bijwerken with {
      description 'Rol: aanbieder'
      color markering
    }
    include spec.koppelingen.k_toetsresultaat_doorgeven with {
      description 'Rol: aanbieder'
      color markering
    }
    exclude spec, spec.koppelingen, instelling
    exclude * -> *
    include spec.koppelingen.k_onderwijsspecificatie_ophalen -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
    include spec.koppelingen.k_specificatiestatus_volgen -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
    include spec.koppelingen.k_opleidingsprogrammaverbintenis_ontsluiten -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
    include spec.koppelingen.k_verbintenis_en_planninggroep_doorgeven -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
    include spec.koppelingen.k_leeromgeving_inrichten -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
    include spec.koppelingen.k_leeromgeving_bijwerken -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
    include spec.koppelingen.k_toetsresultaat_doorgeven -> instelling.lms where tag is #hoofdplaat with {
      title ''
    }
  }
}
