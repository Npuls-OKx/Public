// Situaties waarin de componenten niet op dezelfde versie zitten.
//
// Deze views hergebruiken de systemen en de versies van de koppelingen, en geven
// ze per view een eigen omschrijving en kleur met `with`.
// Zo staat een toestand in de view en niet in het model, want het model beschrijft
// de keten en niet één moment daarin.

views {

  dynamic view volgorde_fout {
    title 'Situaties / De volgorde die niet werkt'
    order 13
    description '
      Een afnemer die eerder overstapt dan zijn aanbieder roept een endpoint aan
      dat nog niet bestaat. Van de vier combinaties van versies is dit de enige
      die breekt, en de release notes waarschuwen er niet voor.
    '

    okx.store.pkg_kvs.kvs_v2 -> lev_p 'release notes: meld voortaan op verwerkingsuitkomst'
    lev_p -> instelling.p 'verlegt de aanroep in de eerstvolgende release'
    instelling.p -> instelling.oc 'POST verwerkingsuitkomst'
    instelling.oc -> instelling.p 'dat endpoint bestaat hier nog niet'
    lev_oc -> instelling.oc 'voegt het pas een ronde later toe'
  }

  view afnemer_blijft {
    title 'Situaties / De afnemer gaat niet mee'
    order 14
    description '
      Het venster sluit niet uit zichzelf. De catalogus draagt het oude pad naast
      het nieuwe zolang het leermanagementsysteem erop meldt, en wat er gebeurt
      als de termijn afloopt, legt het beleid niet vast.
    '

    autoLayout TopBottom 40 40

    include instelling
    include instelling.oc with {
      description 'Bedient 1.0 én 2.0, voor onbepaalde tijd'
      color amber
    }
    include instelling.p with {
      description 'Volledig op 2.0, oude endpoint verwijderd'
      color green
    }
    include instelling.lms with {
      description 'Blijft op 1.0: de hernoeming levert deze leverancier niets op'
      color red
    }
    include instelling.oc -> instelling.p with {
      title 'meldt op specificatie-beschikbaar (2.0)'
      color green
    }
    include instelling.lms -> instelling.oc with {
      title 'meldt op inrichtingsstatus (1.0), zonder einddatum'
      color red
    }

    exclude instelling.p -> instelling.oc
    exclude instelling.oc -> instelling.lms
    exclude instelling.oc.** -> instelling.p.**
    exclude instelling.p.** -> instelling.oc.**
    exclude instelling.oc.** -> instelling.lms.**
    exclude instelling.lms.** -> instelling.oc.**
  }

  view aanbieder_achter {
    title 'Situaties / De aanbieder loopt achter'
    order 15
    description '
      Een achterblijvende afnemer houdt één koppeling op, een achterblijvende
      aanbieder houdt ze allemaal op. De releasekalender van de catalogus is
      daarmee het plafond voor de hele keten.
    '

    autoLayout TopBottom 40 40

    include instelling
    include instelling.oc with {
      description 'Nog op 1.0: het nieuwe endpoint bestaat hier niet'
      color red
    }
    include instelling.p with {
      description 'Klaar voor 2.0, kan niet over'
      color amber
    }
    include instelling.lms with {
      description 'Klaar voor 2.0, kan niet over'
      color amber
    }
    include instelling.p -> instelling.oc with {
      title 'wacht op de aanbieder'
      color red
    }
    include instelling.lms -> instelling.oc with {
      title 'wacht op de aanbieder'
      color red
    }

    exclude instelling.oc -> instelling.p
    exclude instelling.oc -> instelling.lms
    exclude instelling.oc.** -> instelling.p.**
    exclude instelling.p.** -> instelling.oc.**
    exclude instelling.oc.** -> instelling.lms.**
    exclude instelling.lms.** -> instelling.oc.**
  }

  view derde_major {
    title 'Situaties / Een tweede major tijdens het venster'
    order 16
    description '
      Volgens de hoofdregel komt 3.0 naast 2.0. Zolang het leermanagementsysteem
      nog op 1.0 draait, zijn er drie versies tegelijk gepubliceerd, en de
      catalogus bedient ze alle drie.
    '

    autoLayout TopBottom 40 40

    include lo_versies, instelling, instelling.lms
    include instelling.oc with {
      description 'Bedient 1.0, 2.0 en 3.0 tegelijk'
      color amber
    }
    include lo_versies.lo_10 with {
      description 'Vervalt aan het eind van de termijn'
      color red
    }
    include lo_versies.lo_20 with {
      description 'Blijft zolang er partijen op draaien'
      color green
    }
    include lo_versies.lo_30 with {
      description 'Komt ernaast'
      color green
    }
    include lo_versies.lo_10 -> instelling.lms with {
      title 'draait hier nog'
      color red
    }
    include lo_versies.lo_20 -> instelling.oc
    include lo_versies.lo_30 -> instelling.oc

    exclude instelling.oc -> instelling.lms
    exclude instelling.lms -> instelling.oc
    exclude instelling.oc.** -> instelling.lms.**
    exclude instelling.lms.** -> instelling.oc.**
  }
}

views {

  view reikwijdte {
    title 'Versiescenario / Reikwijdte per bumptype'
    order 17
    description '
      Het aantal pijlen is het verhaal. De major raakt alle drie de partijen en
      kost twee releaseronden, de minor raakt alleen wie de nieuwe mogelijkheid
      wil gebruiken, en de patch raakt niemand.
    '

    autoLayout TopBottom 40 40

    include instelling, instelling.oc, instelling.p, instelling.lms
    include okx.store.pkg_kvs.kvs_v2 with {
      description 'major: twee endpoints hernoemd'
      color red
    }
    include okx.store.pkg_igm.igm_v110 with {
      description 'minor: optioneel veld erbij'
      color amber
    }
    include okx.store.pkg_kvs.kvs_v201 with {
      description 'patch: tekst gelijkgetrokken met het schema — geen enkele partij hoeft iets'
      color green
    }
    include okx.store.pkg_kvs.kvs_v2 -> instelling.oc with {
      title 'endpoint erbij, oude pad blijft staan'
      color red
    }
    include okx.store.pkg_kvs.kvs_v2 -> instelling.p with {
      title 'endpoint erbij én aanroep verleggen'
      color red
    }
    include okx.store.pkg_kvs.kvs_v2 -> instelling.lms with {
      title 'aanroep verleggen, pas bij de halfjaarrelease'
      color red
    }
    include okx.store.pkg_igm.igm_v110 -> instelling.oc with {
      title 'mag het nieuwe veld leveren, hoeft niet'
      color amber
    }

    exclude okx.store.pkg_kvs.kvs_v1 -> instelling.oc
    exclude okx.store.pkg_kvs.kvs_v1 -> instelling.p
    exclude okx.store.pkg_kvs.kvs_v1 -> instelling.lms
    exclude okx.store.pkg_kvs.kvs_v2 -> okx.store.pkg_igm.igm_v110
    exclude instelling.oc -> instelling.p
    exclude instelling.p -> instelling.oc
    exclude instelling.oc -> instelling.lms
    exclude instelling.lms -> instelling.oc
    exclude instelling.oc.** -> instelling.p.**
    exclude instelling.p.** -> instelling.oc.**
    exclude instelling.oc.** -> instelling.lms.**
    exclude instelling.lms.** -> instelling.oc.**
  }
}
