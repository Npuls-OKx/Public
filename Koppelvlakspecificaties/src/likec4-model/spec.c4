specification {

  // De kleuren van ArchiMate, zoals Archi ze standaard gebruikt en het
  // OKx-model ze toepast: de applicatielaag lichtblauw, de OKx-componenten zoals
  // op de informatiestromen-hoofdplaat, business geel, motivatie paars,
  // implementatie en migratie roze, en een grouping grijs.
  // De vlakkleur staat hier; de rand en de zwarte tekst staan per kleur in
  // likec4.config.json.
  color archi-applicatie #B5FFFF
  color archi-component #80FFFF
  color archi-business #FFFFB5
  color archi-motivatie #CCCCFF
  color archi-implementatie #FFE0E0
  color archi-grouping #D2D7D7

  // Een markering, geen laag: op een hoofdplaatview licht zij de koppeling op en
  // de applicatiedienst waarvan die is afgeleid.
  color markering #FFD966

  element organisatie {
    notation 'Organisatie of afgebakend geheel'
    style {
      textSize lg
      shape rectangle
      color archi-grouping
      opacity 5%
      border dashed
    }
  }

  element rol {
    notation 'Rol: een mens of een partij die handelt'
    style {
      textSize md
      shape person
      color archi-business
      size xs
    }
  }

  element systeem {
    notation 'Applicatiecomponent uit de keten'
    style {
      textSize lg
      shape rectangle
      color archi-component
      opacity 100%
      border solid
      icon ./icons/component.svg
      iconPosition right
      iconSize xs
    }
  }

  element rolsysteem {
    notation 'Rol die een component in een interactie speelt'
    style {
      textSize lg
      shape rectangle
      color archi-applicatie
      icon ./icons/component.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }

  element koppelvlak {
    notation 'Koppelvlak: alle koppelingen die het component raken'
    style {
      textSize lg
      shape rectangle
      color archi-applicatie
      opacity 100%
      border solid
      icon ./icons/interface.svg
      iconPosition right
      iconSize xs
    }
  }

  element dienst {
    notation 'Koppelvlakdienst die het component implementeert'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size sm
      padding sm
      opacity 100%
      border solid
      icon ./icons/service.svg
      iconPosition right
      iconSize xs
    }
  }

  element gedrag {
    notation 'Gedrag zonder eigen endpoint: de dienst roept aan of meldt'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size md
      padding sm
      icon ./icons/function.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }

  element endpoint {
    notation 'Endpoint waarmee het component die dienst levert'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size md
      padding sm
      icon ./icons/interface.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }

  element pakket {
    notation 'Releasepakket onder zijn tag'
    style {
      textSize md
      shape document
      color archi-implementatie
      size sm
      border solid
    }
  }

  element branch {
    notation 'Branch in het repository'
    style {
      textSize md
      shape rectangle
      color archi-implementatie
      size xs
      icon ./icons/workpackage.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }

  relationship melding {
    notation 'Melding: een dun event met een verwijzing naar de resource'
    line dotted
  }

  relationship aanroep {
    notation 'Aanroep: synchroon, met antwoord'
    line solid
  }

  tag v1
  tag v2
  tag v3
  tag breaking
  tag additief
  tag ongewijzigd
}

global {
  styleGroup versiekleuren {
    style element.tag = #v1 {
      color amber
    }
    style element.tag = #v2 {
      color green
    }
    style element.tag = #ongewijzigd {
      color archi-applicatie
    }
    style element.tag = #breaking {
      color red
    }
  }
}
