// De specificatie als bouwwerk: waar de versienummers zitten en wat waarvan afhangt.
//
// De keten in componenten.c4 beschrijft wie wat implementeert. Dit bestand beschrijft
// waaruit de specificatie zelf is opgebouwd, want daar zit de modulariteit: een
// koppeling draagt haar eigen versie, haar berichtstromen zetten koppelvlakdiensten
// en interactiepatronen in, en die diensten dragen endpoints die op een schema uit
// het pakket informatie- en gegevensmodellen staan.
//
// De koppelingen zelf staan in koppelingen.c4, onder hetzelfde pakketelement.
//
// Bron: Koppelvlakdiensten/ voor de endpoints, Informatie-en-gegevensmodellen/schemas/
// voor de schema's.

specification {
  element koppeling {
    notation 'Koppeling: endpoint-interacties met één doel, één op één met een OEAPI-profiel'
    style {
      textSize lg
      shape rectangle
      color archi-applicatie
      opacity 100%
      border solid
      icon ./icons/collaboration.svg
      iconPosition right
      iconSize xs
    }
  }

  element berichtstroom {
    notation 'Berichtstroom: een uitwisseling binnen een koppeling'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size md
      padding sm
      icon ./icons/process.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }

  element patroon {
    notation 'Interactiepatroon: hergebruikt over koppelingen heen'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size md
      padding sm
      icon ./icons/interaction.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }

  element schema {
    notation 'JSON Schema uit het pakket informatie- en gegevensmodellen'
    style {
      textSize md
      shape rectangle
      color archi-applicatie
      size md
      padding sm
      icon ./icons/dataobject.svg
      iconPosition right
      iconSize xs
      border solid
    }
  }
}

model {

  spec = organisatie 'Releasepakket koppelvlakspecificatie' {

    patronen = organisatie 'Interactiepatronen' {
      pat_event = patroon 'Event Notification'
      pat_async = patroon 'Asynchronous Request-Reply'
      pat_ecst = patroon 'Event-Carried State Transfer'
      pat_reqrep = patroon 'Request-Reply'
      pat_subscr = patroon 'Subscription registration'
    }
  }

  modellen = organisatie 'Releasepakket informatie- en gegevensmodellen' {
    sch_spec = schema 'education-specification.json'
    sch_delta = schema 'education-specification-delta.json'
    sch_ref = schema 'specification-reference.json'
    sch_changed = schema 'specification-changed.json'
    sch_statuschanged = schema 'specification-status-changed.json'
    sch_status = schema 'processing-status.json'
    sch_offering = schema 'education-offering.json'
    sch_subscription = schema 'subscription.json'
  }

  // ── Welk endpoint op welk schema staat ─────────────────────────────────
  instelling.oc.kv_oc.oc_spec_aanbieder.oc_get_spec -> sch_spec
  instelling.oc.kv_oc.oc_spec_aanbieder.oc_get_delta -> sch_delta
  instelling.oc.kv_oc.oc_spec_aanbieder.oc_get_speclijst -> sch_ref
  instelling.oc.kv_oc.oc_uitkomst_afnemer.oc_hook_verwerkingsuitkomst -> sch_status
  instelling.oc.kv_oc.oc_abonnement_aanbieder.oc_post_abonnementen -> sch_subscription
  instelling.p.kv_p.p_spec_afnemer.p_hook_beschikbaar -> sch_ref
  instelling.p.kv_p.p_spec_afnemer.p_hook_gewijzigd -> sch_changed
  instelling.p.kv_p.p_spec_afnemer.p_hook_status -> sch_statuschanged
  instelling.p.kv_p.p_aanbod_aanbieder.p_get_aanbod_id -> sch_offering
  instelling.p.kv_p.p_aanbod_aanbieder.p_get_aanbod -> sch_offering
  instelling.p.kv_p.p_abonnement_aanbieder.p_post_abonnementen -> sch_subscription
  instelling.lms.kv_lms.lms_spec_afnemer.lms_hook_beschikbaar -> sch_ref
  instelling.lms.kv_lms.lms_spec_afnemer.lms_hook_gewijzigd -> sch_changed
  instelling.lms.kv_lms.lms_spec_afnemer.lms_hook_status -> sch_statuschanged
}
