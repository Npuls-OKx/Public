  spec.koppelingen.k_late_wijziging_toetsen -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_late_wijziging_toetsen -> spec.koppelingen.k_reconciliatie 'vereist'
  spec.koppelingen.k_planningselementen_ontsluiten -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_planningselementen_ontsluiten -> spec.koppelingen.k_reconciliatie 'vereist'
  spec.koppelingen.k_geplande_leergelegenheden_ontsluiten -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_geplande_leergelegenheden_ontsluiten -> spec.koppelingen.k_reconciliatie 'vereist'
  spec.koppelingen.k_planninggroepen_ontsluiten -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_planninggroepen_ontsluiten -> spec.koppelingen.k_reconciliatie 'vereist'
