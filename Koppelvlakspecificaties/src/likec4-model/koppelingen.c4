  spec.koppelingen.k_inschrijfbaar_aanbod_ontsluiten -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_inschrijfbaar_aanbod_ontsluiten -> spec.koppelingen.k_reconciliatie 'vereist'
  spec.koppelingen.k_specificatie_ter_vaststelling_aanbieden -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_specificatie_ter_vaststelling_aanbieden -> spec.koppelingen.k_reconciliatie 'vereist'
  spec.koppelingen.k_opleidingsaanbod_aanmaken -> spec.koppelingen.k_onderwijsspecificatie_ophalen 'vereist'
  spec.koppelingen.k_opleidingsaanbod_aanmaken -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_opleidingsaanbod_aanmaken -> spec.koppelingen.k_reconciliatie 'vereist'
  spec.koppelingen.k_opleidingsaanbod_herplannen -> spec.koppelingen.k_onderwijsspecificatie_ophalen 'vereist'
  spec.koppelingen.k_opleidingsaanbod_herplannen -> spec.koppelingen.k_afleverabonnement_registreren 'vereist'
  spec.koppelingen.k_opleidingsaanbod_herplannen -> spec.koppelingen.k_reconciliatie 'vereist'
